WUDANG_LISTEN_ADDR=127.0.0.1:50051
WUDANG_DATABASE_URL=postgres://wudang:wudang@127.0.0.1:5432/wudang
WUDANG_GIT_ROOT=./data/git
WUDANG_BLOB_ROOT=./data/blobs

# Generate independent 32-byte values and encode them with base64.
WUDANG_JWT_SECRET_BASE64=
WUDANG_STORAGE_KEY_BASE64=
WUDANG_REFRESH_PEPPER_BASE64=
WUDANG_STORAGE_KEY_ID=local-v1
WUDANG_JWT_ISSUER=wudang
WUDANG_JWT_AUDIENCE=wudang-desktop
WUDANG_ACCESS_TTL_SECONDS=900
WUDANG_REFRESH_TTL_DAYS=30
WUDANG_POSTGRES_MAX_CONNECTIONS=32
WUDANG_ALLOW_LOCAL_REGISTRATION=true

# Bare Git repositories remain standard Git repositories and must live on an
# encrypted filesystem/volume in production.
WUDANG_REQUIRE_ENCRYPTED_GIT_VOLUME=false
WUDANG_GIT_VOLUME_ENCRYPTED=false

# Optional public smart-HTTP/SSH base. Leave empty until a Git transport is deployed.
WUDANG_GIT_PUBLIC_BASE_URL=

# Required together for non-loopback listeners.
WUDANG_TLS_CERT_PATH=
WUDANG_TLS_KEY_PATH=
